# Server Configuration
# Cloudflare Turnstile (secret stays on the backend).
TURNSTILE_MODE=auto
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,toancaocapueh.id.vn,www.toancaocapueh.id.vn

PORT=5000
# Incremental NestJS migration. Use express for HTTP-composition rollback.
BACKEND_HTTP_RUNTIME=nest
NODE_ENV=production
TRUST_PROXY_HOPS=1

# Session cookie. Use SameSite=none only when frontend and backend are on
# different sites; it requires HTTPS and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=true
# Optional, for example .toancaocapueh.id.vn when API and frontend use subdomains.
SESSION_COOKIE_DOMAIN=

# Long random secret used to hash password-reset OTPs. Keep it stable across restarts.
OTP_SECRET=replace_with_at_least_32_random_bytes

# MongoDB Connection String (Atlas Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DIRECT_URI=
MONGODB_DB_NAME=UEH_TCC
REQUIRE_DATABASE=true
# Optional comma-separated DNS resolvers; normally leave blank. If Node cannot
# resolve Atlas SRV records, use known resolvers such as 1.1.1.1,8.8.8.8.
MONGODB_DNS_SERVERS=

# Client URLs (CORS)
CLIENT_URL=https://toancaocapueh.id.vn
FRONTEND_URL=https://toancaocapueh.id.vn

# Email Service Configuration (Resend or Gmail SMTP)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=α∫M4A <notifications@toancaocapueh.id.vn>
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Notification outbox: disabled until sender/domain configuration is ready.
# Uses Resend when RESEND_API_KEY is set; otherwise the SMTP settings above.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SITE_URL=https://toancaocapueh.id.vn
# Public API ORIGIN that serves /api/notification-email/unsubscribe.
# Set to the real Render/custom API origin, or same origin when using a proxy.
NOTIFICATION_API_URL=https://ueh-tcc-backend.onrender.com
NOTIFICATION_REPLY_TO=luphuc321@gmail.com
NOTIFICATION_ADMIN_EMAIL=luphuc321@gmail.com
# Generate a random value, >=32 characters. Keep stable across deploys.
NOTIFICATION_UNSUBSCRIBE_SECRET=

# Allow printing OTP codes locally only. Never enable this in production.
ALLOW_MOCK_EMAIL=false

# OAuth
ADMIN_EMAIL=your_admin_email@example.com
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Firebase ID-token verification. The project ID is public; this app safely
# defaults to `toancaocapueh-auth`, while an environment value can override it.
FIREBASE_PROJECT_ID=toancaocapueh-auth
# Public OAuth web Client ID, same as frontend VITE_GOOGLE_CLIENT_ID.
# Required to complete Google emails when Firebase allows multiple accounts/email.
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Optional comma-separated allowlist if One Tap and Firebase use different web clients.
# GOOGLE_CLIENT_IDS=first_client.apps.googleusercontent.com,second_client.apps.googleusercontent.com
# Emergency kill switch for Firebase/Google backend session exchange.
FIREBASE_AUTH_DISABLED=false

# PayOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_CONFIRM_TOKEN=use_a_long_random_confirmation_token
