{
  "name": "ueh-tcc-backend",
  "version": "1.0.0",
  "description": "Backend API for UEH TCC supporting study helper app",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.mjs",
    "seed:flashcards": "node scripts/seed-study-content.js",
    "test": "node --test",
    "check": "npm run test",
    "build": "tsc -p tsconfig.json",
    "postinstall": "npm run build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "prestart": "npm run build",
    "predev": "npm run build",
    "seed:community": "node scripts/seed-community-db.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "5.3.0",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.3.4",
    "mongoose": "^9.13.0",
    "nodemailer": "^10.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
