# Firebase Configuration for Real Authentication
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Public OAuth application identifier (the client secret stays on backend only)
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id

# Leave blank for a same-origin production deployment and the Vite dev proxy.
# Set this only when the API is hosted on a separate HTTPS origin.
VITE_API_URL=
