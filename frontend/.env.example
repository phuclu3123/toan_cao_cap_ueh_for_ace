# Firebase Configuration for Real Authentication.
# The canonical production host forces its own first-party authDomain in code.
# For other Netlify domains, set VITE_FIREBASE_AUTH_DOMAIN only after the
# /__/auth proxy and provider redirect URI are configured (see README.md).
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# GitHub OAuth is started with public metadata from /api/auth/providers.
# Keep both GitHub credentials in the backend environment; never put a secret here.

# Leave blank for a same-origin production deployment and the Vite dev proxy.
# The canonical toancaocapueh.id.vn production host always uses Netlify's /api
# proxy so its HttpOnly session cookie stays first-party.
# Set this only for preview deployments that intentionally use another API origin.
VITE_API_URL=
